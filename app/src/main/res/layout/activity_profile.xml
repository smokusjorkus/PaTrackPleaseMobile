<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/Acti"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".Profile.ProfileActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="64dp"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/mainContentContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="24dp"
                app:layout_constraintWidth_max="540dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvProfileTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit_bold"
                    android:text="Profile"
                    android:textColor="#212529"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivProfileAvatar"/>

                <TextView
                    android:id="@+id/tvProfileSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/outfit_regular"
                    android:text="Manage your account settings"
                    android:textColor="#6C757D"
                    android:textSize="14sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/ivProfileAvatar"
                    app:layout_constraintTop_toBottomOf="@id/tvProfileTitle" />

                <!-- Standard ImageView -->
                <ImageView
                    android:id="@+id/ivProfileAvatar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_launcher_background"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/tvProfileSubtitle"/>

                <!-- Standard CardView -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardProfileHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    app:cardBackgroundColor="#212529"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="4dp"
                    app:layout_constraintTop_toBottomOf="@id/tvProfileSubtitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp">

                        <ImageView
                            android:id="@+id/ivProfilePicture"
                            android:layout_width="72dp"
                            android:layout_height="72dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_launcher_background"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                        <TextView
                            android:id="@+id/tvHeaderName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="Username"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toEndOf="@id/ivProfilePicture"
                            app:layout_constraintEnd_toStartOf="@id/btnChangePhoto"
                            app:layout_constraintTop_toTopOf="@id/ivProfilePicture"
                            app:layout_constraintBottom_toTopOf="@id/tvHeaderEmail"
                            app:layout_constraintVertical_chainStyle="packed"/>

                        <TextView
                            android:id="@+id/tvHeaderEmail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:text="email@example.com"
                            android:textColor="#ADB5BD"
                            android:textSize="13sp"
                            app:layout_constraintStart_toEndOf="@id/ivProfilePicture"
                            app:layout_constraintEnd_toStartOf="@id/btnChangePhoto"
                            app:layout_constraintTop_toBottomOf="@id/tvHeaderName"
                            app:layout_constraintBottom_toBottomOf="@id/ivProfilePicture" />

                        <!-- Standard Button -->
                        <Button
                            android:id="@+id/btnChangePhoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="38dp"
                            android:text="Edit"
                            android:textAllCaps="false"
                            android:textColor="#212529"
                            android:textSize="13sp"
                            android:backgroundTint="#FFE733"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- UNIFIED ACCOUNT SETTINGS CARD -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAccountSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:layout_constraintTop_toBottomOf="@id/cardProfileHeader"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- NAME Section -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/lbl_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="DISPLAY NAME"
                                android:textColor="#6C757D"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:fontFamily="@font/outfit_bold"/>

                            <TextView
                                android:id="@+id/tvValueName"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="Username"
                                android:textColor="#212529"
                                android:textSize="16sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/btnChangeUsername"
                                app:layout_constraintTop_toBottomOf="@id/lbl_name"
                                android:fontFamily="@font/outfit_thin"/>

                            <Button
                                android:id="@+id/btnChangeUsername"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Change"
                                android:textAllCaps="false"
                                android:textColor="#495057"
                                android:textSize="13sp"
                                android:backgroundTint="#F8F9FA"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:fontFamily="@font/outfit_regular"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="20dp"
                            android:background="#F1F3F5" />

                        <!-- EMAIL Section -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/lbl_email"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="EMAIL ADDRESS"
                                android:textColor="#6C757D"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:fontFamily="@font/outfit_bold"/>

                            <TextView
                                android:id="@+id/tvValueEmail"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="email@example.com"
                                android:textColor="#212529"
                                android:textSize="16sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/btnChangeEmail"
                                app:layout_constraintTop_toBottomOf="@id/lbl_email"
                                android:fontFamily="@font/outfit_thin"/>

                            <Button
                                android:id="@+id/btnChangeEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Change"
                                android:textAllCaps="false"
                                android:textColor="#495057"
                                android:textSize="13sp"
                                android:backgroundTint="#F8F9FA"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:fontFamily="@font/outfit_regular"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginHorizontal="20dp"
                            android:background="#F1F3F5" />

                        <!-- PASSWORD Section -->
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="20dp">

                            <TextView
                                android:id="@+id/lbl_password"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PASSWORD"
                                android:textColor="#6C757D"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                android:fontFamily="@font/outfit_bold"/>

                            <TextView
                                android:id="@+id/tvValuePassword"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:text="••••••••••"
                                android:textColor="#212529"
                                android:textSize="16sp"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/btnChangePassword"
                                app:layout_constraintTop_toBottomOf="@id/lbl_password" />

                            <Button
                                android:id="@+id/btnChangePassword"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Update"
                                android:textAllCaps="false"
                                android:textColor="#495057"
                                android:textSize="13sp"
                                android:backgroundTint="#F8F9FA"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"
                                android:fontFamily="@font/outfit_regular"/>
                        </androidx.constraintlayout.widget.ConstraintLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <Button
                    android:id="@+id/btnRemovePhoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:padding="16dp"
                    android:text="Remove Profile Photo"
                    android:textAllCaps="false"
                    android:textColor="#D32F2F"
                    android:textSize="15sp"
                    android:backgroundTint="#FFF0F0"
                    app:layout_constraintTop_toBottomOf="@id/cardAccountSettings"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:fontFamily="@font/outfit_regular"/>

                <Button
                    android:id="@+id/btnLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:padding="16dp"
                    android:text="Log Out"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:backgroundTint="#212529"
                    app:layout_constraintTop_toBottomOf="@id/btnRemovePhoto"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:fontFamily="@font/outfit_regular"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="JPG or PNG. Max size of 800K"
                    android:textColor="#ADB5BD"
                    android:textSize="12sp"
                    app:layout_constraintTop_toBottomOf="@id/btnLogout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:fontFamily="@font/outfit_thin"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- CUSTOM BOTTOM NAVIGATION (No AppCompat Required) -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="horizontal">

        <!-- Dashboard Button -->
        <LinearLayout
            android:id="@+id/nav_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_today"
                android:tint="#6C757D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textSize="12sp"
                android:textColor="#6C757D" />
        </LinearLayout>

        <!-- Tasks Button -->
        <LinearLayout
            android:id="@+id/nav_tasks"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="#6C757D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tasks"
                android:textSize="12sp"
                android:textColor="#6C757D" />
        </LinearLayout>

        <!-- Profile Button (Active) -->
        <LinearLayout
            android:id="@+id/nav_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackground">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="#212529" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#212529" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
