<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:background="#fffdfa"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Profile Image (Equivalent to your <img> or <User> icon) -->
    <ImageView
        android:id="@+id/ivSidebarProfile"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@android:drawable/sym_def_app_icon" /> <!-- Placeholder -->

    <!-- Username (Equivalent to your <p>{userName}</p>) -->
    <TextView
        android:id="@+id/tvSidebarUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="User"
        android:textColor="#212121"
        android:textSize="20sp"
        android:textStyle="bold"
        android:fontFamily="@font/outfit_bold" />

</LinearLayout>